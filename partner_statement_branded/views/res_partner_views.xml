<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_customer_statement" model="ir.ui.view">
            <field name="name">res.partner.form.customer.statement</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales_purchases']/group[@name='container_row_2']/group[@name='misc']" position="inside">
                    <field name="statement_footer_text" placeholder="Optional note printed on customer statements"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
